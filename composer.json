{
  "name": "voku/portable-utf8-benchmark",
  "description": "Benchmarks for comparing UTF-8 helper libraries",
  "type": "project",
  "version": "0.0.1",
  "config": {
    "optimize-autoloader": true,
    "vendor-dir": "vendor/composer/",
    "github-protocols": [
      "https"
    ],
    "sort-packages": true
  },
  "scripts": {
    "bench": "php run_benchmarks.php",
    "bench:json": "php run_benchmarks.php --json --output=build/benchmark-results.json"
  },
  "require": {
    "patchwork/utf8": "^1.3",
    "voku/portable-utf8": "^6.1"
  }
}
